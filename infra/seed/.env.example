# ============================================================================
# Ground Truth Curation App - Seed Data Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# This file contains environment variables for seeding all databases

# ============================================================================
# GROUND TRUTH SQL SERVER (Azure SQL Database)
# ============================================================================
# Used by: groundtruth/prepare-gt-db.py
# Purpose: Stores curation workflow, ground truth definitions, tags, comments
# Database: GroundTruthDB
# Tables: GROUND_TRUTH_DEFINITION, GROUND_TRUTH_ENTRY, DATA_QUERY_DEFINITION,
#         GROUND_TRUTH_CONTEXT, CONTEXT_PARAMETER, COMMENT, TAG,
#         GROUND_TRUTH_TAG, CONVERSATION, GROUND_TRUTH_DEFINITION_CONVERSATION

# Azure SQL connection string for Ground Truth database (passwordless Azure AD auth)
# Format: 'Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server-name>.database.windows.net,1433;Database=<db-name>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30'
GT_AZURE_SQL_CONNECTIONSTRING='Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server-name>.database.windows.net,1433;Database=<db-name>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30'

# ============================================================================
# SYSTEM SQL SERVER (Azure SQL Database)
# ============================================================================
# Used by: system/import-support-tickets.py
# Purpose: Stores demo/system data that AI queries (e.g., support tickets)
# Database: SystemDemoDB (or ManufacturingDataRelDB)
# Tables: support_tickets

# SQL Server hostname (without tcp: prefix or port)
SYSTEM_DB_SERVER=your-system-server.database.windows.net

# Database name for system/demo data
SYSTEM_DB_DATABASE=SystemDemoDB

# SQL Server authentication username
SYSTEM_DB_USERNAME=sqladmin

# SQL Server authentication password
SYSTEM_DB_PASSWORD=YourSecurePassword123!

# ODBC driver (default: ODBC Driver 18 for SQL Server)
SYSTEM_DB_DRIVER={ODBC Driver 18 for SQL Server}

# SQL Server port (default: 1433)
SYSTEM_DB_PORT=1433

# ============================================================================
# COSMOS DB (NoSQL)
# ============================================================================
# Used by: cosmos/upload-defects.py
# Purpose: Stores NoSQL demo data (manufacturing defects/repairs)
# Database: ManufacturingDefects (or ManufacturingDataDocDB)
# Container: repairs (partitioned by /partitionKey)

# Cosmos DB account endpoint URL
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/

# Cosmos DB primary access key (fallback if Azure AD auth fails)
COSMOS_PRIMARY_KEY=your-cosmos-primary-key-here==

# ============================================================================
# OPTIONAL: Azure Authentication
# ============================================================================
# If using Azure CLI or Managed Identity for authentication, ensure you're logged in:
#   az login
# The scripts will use DefaultAzureCredential for passwordless auth where supported

# ============================================================================
# NOTES
# ============================================================================
# 1. Ground Truth DB uses Azure AD passwordless auth (GT_AZURE_SQL_CONNECTIONSTRING)
# 2. System DB uses SQL authentication (SYSTEM_DB_* variables)
# 3. Cosmos DB tries Azure AD first, falls back to COSMOS_PRIMARY_KEY
# 4. Run 'source .venv/bin/activate' before executing seed scripts
# 5. See infra/seed/README.md for execution order and detailed instructions
